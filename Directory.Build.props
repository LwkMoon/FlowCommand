<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Authors>LwkMoon</Authors>
    <Product>FlowCommand</Product>
    <Copyright>Copyright (c) 2026 LwkMoon</Copyright>
    <Description>Voice-controlled Windows command palette: turns the text Wispr Flow dictates into validated, locally executed Windows actions.</Description>
    <RepositoryUrl>https://github.com/LwkMoon/FlowCommand</RepositoryUrl>
  </PropertyGroup>
</Project>
