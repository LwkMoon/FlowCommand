<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Authors>LwkMoon</Authors>
    <Product>FlowCommand</Product>
    <Copyright>Copyright (c) 2026 LwkMoon</Copyright>
    <Description>Command palette for Windows: turns a short spoken or typed command into one validated, locally executed action. Works offline; online AI is optional.</Description>
    <RepositoryUrl>https://github.com/LwkMoon/FlowCommand</RepositoryUrl>
  </PropertyGroup>
</Project>
