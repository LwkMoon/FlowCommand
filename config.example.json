{
  // FlowCommand example configuration. Copy any section into %APPDATA%\FlowCommand\config.json.
  // Comments and trailing commas are allowed. This file never contains secrets: API keys are stored
  // encrypted with Windows DPAPI (Settings window) or read from GEMINI_API_KEY / GOOGLE_API_KEY / ANTHROPIC_API_KEY.

  "configVersion": 2,

  // ---- AI provider ----
  "provider": "gemini",                  // "gemini" or "anthropic"
  "model": "gemini-3.5-flash-lite",      // any model id your key can use, e.g. "gemini-3.8-flash" or "claude-haiku-5-5"
  "geminiThinkingLevel": "low",          // Gemini only: minimal | low | medium | high | "" (model default). Lower is faster.
  "requestTimeoutSeconds": 30,           // 5-60

  // ---- how the palette opens ----
  "doubleTapEnabled": true,              // double-tap a key to open the palette
  "doubleTapKey": "backtick",            // backtick (the key left of 1) | capslock | scrolllock | pause
  "doubleTapIntervalMs": 400,            // maximum gap between the two taps (150-1000)
  "ignoreWhenTextBoxFocused": true,      // ignore the double-tap while a text box has focus (normal dictation is untouched)
  "openWhenFocusUnknown": true,          // if focus cannot be classified, open anyway
  "webContentProcesses": ["chrome", "msedge", "firefox", "opera", "brave", "vivaldi", "code", "cursor", "slack", "discord", "teams", "notion", "obsidian"],
  "hotkey": "",                          // optional extra shortcut such as "Ctrl+Alt+Space". Always opens the palette, even from a text box.

  // ---- submitting what Wispr Flow inserts ----
  "autoSubmitMode": "paste",             // paste | idle | off
  "autoSubmitDelayMs": 900,              // quiet period before auto-submit (200-5000)
  "pasteThresholdChars": 4,
  "reclaimFocusAfterAction": true,       // return focus to the palette after an action so the next dictation lands in it

  // ---- safety ----
  "dryRun": false,                       // interpret commands but never run them
  "confirmModerateActions": false,       // ask before moderate-risk actions (close app, Bluetooth, lock, port inspection)
  "confirmAllActions": false,
  "useConversationContext": true,        // lets "actually, the other one" work; kept in memory for ten minutes at most
  "logTranscripts": false,               // include dictated text in the local log

  // Allowlist. An action that is not listed here can never run, whatever the AI answers.
  // Remove entries to disable features (for example "kill_process_on_port" or "lock_workstation").
  "enabledActions": [
    "open_application",
    "close_application",
    "activate_window",
    "minimize_window",
    "maximize_window",
    "restore_window",
    "show_desktop",
    "restore_windows",
    "open_folder",
    "open_project",
    "open_settings",
    "bluetooth_set",
    "inspect_port",
    "kill_process_on_port",
    "media_control",
    "lock_workstation",
    "take_screenshot",
    "open_website",
    "search_web"
  ],

  // "Open my browser", "open my editor" and similar requests resolve to these application ids.
  // On first run FlowCommand points "browser" at your Windows default browser when it can detect it.
  "defaultApps": {
    "browser": "chrome",
    "editor": "vscode",
    "terminal": "terminal",
    "email": "outlook",
    "music": "spotify",
    "chat": "discord",
    "video": "vlc",
    "notes": "notepad",
    "office": "word"
  },

  // ---- websites and web search ----
  "searchUrl": "https://www.google.com/search?q={query}",  // https only, must contain {query}. Try https://duckduckgo.com/?q={query}
  "websiteBrowser": "",                  // "" = your Windows default browser, or an application id such as "chrome"

  // Say "open GitHub" or "open Gmail". Add your own: "name": "https://..." (http and https only).
