<Window x:Class="FlowCommand.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to FlowCommand" Width="540" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Welcome to FlowCommand" FontSize="22" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="FlowCommand turns a short spoken or typed command into an action on your PC: open an app, folder or website, search the web, change the volume, take a screenshot and more. It keeps running quietly in the notification area (tray)."/>

                <TextBlock Text="How it works" FontWeight="SemiBold" FontSize="15" Margin="0,18,0,4"
                           AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock TextWrapping="Wrap" Text="1.  Double-tap the ` key (or use your hotkey) to open the command palette."/>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Text="2.  Say your command with a dictation tool, or just type it."/>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Text="3.  Press Enter. FlowCommand runs it, and asks first when something is risky."/>

                <TextBlock Text="How should commands be understood?" FontWeight="SemiBold" FontSize="15" Margin="0,18,0,6"
                           AutomationProperties.HeadingLevel="Level2"/>
                <RadioButton x:Name="OfflineRadio" GroupName="Mode" Content="Offline (recommended to start)" IsChecked="True"
                             AutomationProperties.HelpText="Understands common commands on this PC. No account, no key, nothing is sent anywhere."/>
                <TextBlock TextWrapping="Wrap" Margin="22,2,0,8" Foreground="#FF555555"
                           Text="Understands common commands such as &#8220;open Chrome&#8221;, &#8220;open downloads&#8221; or &#8220;volume up&#8221;. No account or key needed, and nothing leaves your PC."/>
                <RadioButton x:Name="OnlineRadio" GroupName="Mode" Content="Online AI (Google Gemini or Anthropic Claude)"
                             AutomationProperties.HelpText="Understands free-form wording. You provide your own API key. The text of each command is sent to that provider."/>
                <TextBlock TextWrapping="Wrap" Margin="22,2,0,0" Foreground="#FF555555"
                           Text="Understands free-form wording. You provide your own API key in Settings, and the text of each command is sent to the provider you choose (never audio). The provider may charge for usage."/>

                <TextBlock Text="Speaking your commands" FontWeight="SemiBold" FontSize="15" Margin="0,18,0,4"
                           AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock TextWrapping="Wrap"
                           Text="FlowCommand never uses your microphone. To speak commands, use a dictation tool such as Wispr Flow (a separate product from another company; FlowCommand is not affiliated with it) or Windows voice typing. You can also simply type."/>
                <TextBlock x:Name="WisprStatus" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF555555"/>

                <TextBlock Text="Opening the palette" FontWeight="SemiBold" FontSize="15" Margin="0,18,0,6"
                           AutomationProperties.HeadingLevel="Level2"/>
                <CheckBox x:Name="DoubleTapBox" IsChecked="True" Content="Double-tap the ` (backtick) key"
                          AutomationProperties.HelpText="FlowCommand watches this one key to notice a double-tap. It does not record, store or send what you type."/>
                <TextBlock TextWrapping="Wrap" Margin="22,2,0,8" Foreground="#FF555555"
                           Text="FlowCommand watches this one key to notice the double-tap. It does not record, store or send anything you type, and you can pause it from the tray icon. If you turn this off, Ctrl+Alt+Space is used instead."/>
                <CheckBox x:Name="StartupBox" Content="Start FlowCommand when I sign in to Windows"/>

                <TextBlock TextWrapping="Wrap" Margin="0,18,0,0" Foreground="#FF555555"
                           Text="Right-click the FlowCommand tray icon at any time to pause it, open Settings, read the privacy policy or exit."/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="MoreButton" Content="More settings..." Padding="12,5" Click="OnMoreSettings"/>
            <Button x:Name="StartButton" Content="Get started" Padding="16,5" Margin="8,0,0,0" IsDefault="True" Click="OnGetStarted"/>
        </StackPanel>
    </Grid>
</Window>
