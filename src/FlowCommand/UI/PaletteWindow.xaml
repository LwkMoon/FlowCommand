<Window x:Class="FlowCommand.UI.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowCommand" Width="660" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" FontFamily="Segoe UI" FontSize="13">
    <Border Margin="14" CornerRadius="10" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderDimBrush}" BorderThickness="1" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel x:Name="Header" Margin="0,0,0,8" Background="Transparent">
                <TextBlock x:Name="ModeBadge" DockPanel.Dock="Right" Text="DRY RUN" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock Text="FlowCommand" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>

            <Grid>
                <TextBox x:Name="InputBox" FontSize="17" Padding="10,8" MaxLength="500"
                         Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderDimBrush}" CaretBrush="{StaticResource TextBrush}"
                         SelectionBrush="{StaticResource AccentBrush}" AcceptsReturn="False"/>
                <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="15" Foreground="{StaticResource MutedBrush}"
                           Text="Hold your Wispr Flow hotkey and speak&#x2026;"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                <TextBlock x:Name="StatusIcon" Width="22" FontFamily="Segoe UI Symbol" FontSize="14"
                           Foreground="{StaticResource MutedBrush}" Text="&#x2022;"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" MaxWidth="560"
                           Foreground="{StaticResource TextBrush}" Text="Ready."/>
            </StackPanel>

            <Border x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                    Background="#33E5B84C" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1">
                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
            </Border>

            <ItemsControl x:Name="HistoryList" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,2,0,0">
                            <TextBlock Text="{Binding Icon}" Foreground="{Binding Brush}" Width="22" FontFamily="Segoe UI Symbol"/>
                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="570"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="FooterHint" Margin="2,12,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
    </Border>
</Window>
