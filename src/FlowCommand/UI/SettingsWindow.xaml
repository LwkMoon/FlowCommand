<Window x:Class="FlowCommand.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowCommand Settings" Width="560" Height="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="AI provider" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock x:Name="ProviderNote" TextWrapping="Wrap" Foreground="#FF666666" Margin="0,4,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Provider" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ProviderBox" Grid.Column="1" IsEditable="False" SelectionChanged="OnProviderChanged">
                        <ComboBoxItem Content="gemini"/>
                        <ComboBoxItem Content="anthropic"/>
                    </ComboBox>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Model" VerticalAlignment="Center"/>
                    <TextBox x:Name="ModelBox" Grid.Column="1" Padding="4"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="API key" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="KeyBox" Grid.Column="1" Padding="4"/>
                </Grid>
                <TextBlock x:Name="KeyState" Margin="110,0,0,6" Foreground="#FF666666" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="110,0,0,4">
                    <Button x:Name="TestButton" Content="Test AI (runs nothing)" Padding="10,4" Click="OnTest"/>
                    <Button Content="Remove saved key" Padding="10,4" Margin="8,0,0,0" Click="OnRemoveKey"/>
                </StackPanel>
                <TextBlock x:Name="TestResult" Margin="110,6,0,0" TextWrapping="Wrap"/>

                <Separator Margin="0,14"/>
                <TextBlock Text="Opening the palette" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                <CheckBox x:Name="DoubleTapBox" Content="Double-tapping a key opens the palette" Margin="0,2"/>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Trigger key" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DoubleTapKeyBox" Grid.Column="1" IsEditable="False"/>
                </Grid>
                <CheckBox x:Name="IgnoreTextBox" Margin="0,2">
                    <TextBlock TextWrapping="Wrap" Text="Ignore the double-tap when a text box has focus (so normal Wispr dictation is never interrupted)"/>
                </CheckBox>
                <CheckBox x:Name="UnknownBox" Margin="0,2">
                    <TextBlock TextWrapping="Wrap" Text="If FlowCommand can't tell whether a text box is focused (some browsers/Electron apps), open anyway"/>
                </CheckBox>
                <Grid Margin="0,8,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Extra hotkey" VerticalAlignment="Center"/>
                    <TextBox x:Name="HotkeyBox" Grid.Column="1" Padding="4"
                             ToolTip="Optional, e.g. Ctrl+Alt+Space. Always opens the palette, even with a text box focused. Leave empty for none."/>
                </Grid>
                <TextBlock Margin="110,0,0,10" TextWrapping="Wrap" Foreground="#FF666666"
                           Text="Optional. Unlike the double-tap, this always opens the palette, even from inside a text box."/>
                <TextBlock Text="After the palette is open" FontWeight="SemiBold" Margin="0,4,0,6"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto-run" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ModeBox" Grid.Column="1">
                        <ComboBoxItem Content="paste"/>
                        <ComboBoxItem Content="idle"/>
                        <ComboBoxItem Content="off"/>
                    </ComboBox>
                </Grid>
                <TextBlock Margin="110,0,0,6" TextWrapping="Wrap" Foreground="#FF666666"
                           Text="paste = run shortly after a pasted transcript arrives (recommended for Wispr Flow). idle = run after any text change settles. off = Enter only."/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Delay (ms)" VerticalAlignment="Center"/>
                    <TextBox x:Name="DelayBox" Grid.Column="1" Padding="4" Width="90" HorizontalAlignment="Left"/>
                </Grid>

                <Separator Margin="0,14"/>
                <TextBlock Text="Behaviour" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                <CheckBox x:Name="DryRunBox" Content="Dry-run mode (interpret commands but never execute them)" Margin="0,2"/>
                <CheckBox x:Name="ConfirmModerateBox" Content="Confirm moderate-risk actions (close app, Bluetooth, inspect port)" Margin="0,2"/>
                <CheckBox x:Name="ConfirmAllBox" Content="Confirm every action" Margin="0,2"/>
                <CheckBox x:Name="ContextBox" Content="Let the AI see your last few commands (for &quot;actually, the other one&quot;)" Margin="0,2"/>
                <CheckBox x:Name="ReclaimBox" Content="Return focus to the palette after each action" Margin="0,2"/>
                <CheckBox x:Name="LogTranscriptsBox" Content="Include dictated text in the local log (off = actions only)" Margin="0,2"/>
                <CheckBox x:Name="StartupBox" Content="Start FlowCommand when you sign in to Windows" Margin="0,2"/>

                <Separator Margin="0,14"/>
                <TextBlock Text="Allowed actions" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                <TextBlock Text="Anything unchecked can never be executed, whatever the AI says." Foreground="#FF666666" Margin="0,0,0,6"/>
                <StackPanel x:Name="ActionsPanel"/>

                <Separator Margin="0,14"/>
                <TextBlock TextWrapping="Wrap" Foreground="#FF666666"
                           Text="Application aliases, projects and extra folders live in config.json (tray icon → Open config folder). Use the tray's 'Reload config.json' after editing."/>
                <Button Content="Open config file" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0" Click="OnOpenConfig"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Padding="0,5" IsDefault="True" Click="OnSave"/>
            <Button Content="Cancel" Width="90" Padding="0,5" Margin="8,0,0,0" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
