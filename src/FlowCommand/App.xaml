<Application x:Class="FlowCommand.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1E2026"/>
        <SolidColorBrush x:Key="BorderDimBrush" Color="#FF3A3D46"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#FF14161A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFECEEF2"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF8D93A0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6AA7FF"/>
        <SolidColorBrush x:Key="OkBrush" Color="#FF5BD18B"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FFE5B84C"/>
        <SolidColorBrush x:Key="ErrBrush" Color="#FFEF6B6B"/>
    </Application.Resources>
</Application>
